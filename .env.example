# ==============================================================================
# Email Inquiry Routing Configuration
# ==============================================================================

# Destination email for all customer inquiries (default is info@redefinedesignstudio.in)
CONTACT_RECEIVER_EMAIL="info@redefinedesignstudio.in"

# ------------------------------------------------------------------------------
# Option 1: Standard SMTP (Gmail, Google Workspace, Zoho, Titan, SendGrid, etc.)
# ------------------------------------------------------------------------------
# For Gmail / Google Workspace:
# SMTP_HOST="smtp.gmail.com"
# SMTP_PORT=465
# SMTP_SECURE=true
# SMTP_USER="your-email@gmail.com"
# SMTP_PASS="your-16-character-google-app-password"
# SMTP_FROM="Redefining Architecture <your-email@gmail.com>"
#
# For Zoho Mail:
# SMTP_HOST="smtp.zoho.in"
# SMTP_PORT=465
# SMTP_SECURE=true
# SMTP_USER="info@redefinedesignstudio.in"
# SMTP_PASS="your-zoho-password-or-app-password"
# SMTP_FROM="Redefining Architecture <info@redefinedesignstudio.in>"

SMTP_HOST=""
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM=""

# ------------------------------------------------------------------------------
# Option 2: Resend API (Recommended for Vercel Serverless)
# ------------------------------------------------------------------------------
# Sign up at resend.com, generate an API key, and set:
RESEND_API_KEY=""
EMAIL_FROM="Redefining Architecture <onboarding@resend.dev>"

# ------------------------------------------------------------------------------
# Option 3: Custom Webhook (Optional)
# ------------------------------------------------------------------------------
# EMAIL_WEBHOOK_URL="https://script.google.com/macros/s/DEPLOYMENT_ID/exec"
